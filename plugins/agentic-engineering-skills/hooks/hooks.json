{
  "description": "Launch the repository PR gates in the background.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-gates.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking for PR gates"
          }
        ]
      }
    ]
  }
}
